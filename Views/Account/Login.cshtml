@model LoginViewModel
@{
    ViewData["Title"] = "登入";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">
                <i class="bi bi-cpu-fill"></i>
            </div>
            <h1 class="login-title">半導體產業入口網站</h1>
            <p class="login-subtitle">Semiconductor Manufacturing Portal</p>
        </div>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <form asp-action="Login" method="post" class="login-form">
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div class="form-group">
                <label asp-for="Email" class="form-label">電子郵件</label>
                <input asp-for="Email" class="form-control" placeholder="請輸入電子郵件" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">密碼</label>
                <input asp-for="Password" class="form-control" placeholder="請輸入密碼" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">
                    記住我
                </label>
            </div>

            <button type="submit" class="login-btn">
                <i class="bi bi-box-arrow-in-right"></i> 登入
            </button>
        </form>

        <div class="login-footer">
            <p>預設帳號: admin@semiconductor.com / Admin@123</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
